#!/usr/bin/env node
/**
 * sdlc-sync — project `.agent-sdlc/commands/*.md` onto every supported
 * slash-command layout.
 *
 * One source of truth, four dialects:
 *   .dsh/skills/<name>.md          DSH native (frontmatter skill, `/` picker, hot-reload)
 *   .claude/commands/<name>.md     Claude Code
 *   .cursor/commands/<name>.md     Cursor
 *   .opencode/command/<name>.md    opencode
 *
 * Run with --check to fail when a generated file is stale (used by `sdlc doctor`).
 */
import { readFileSync, writeFileSync, existsSync, mkdirSync, readdirSync, rmSync } from 'node:fs';
import { dirname, join, resolve } from 'node:path';

const SELF = resolve(process.argv[1]);
const FRAMEWORK_ROOT = dirname(dirname(SELF));
const ROOT = dirname(FRAMEWORK_ROOT);
const CMD_DIR = join(FRAMEWORK_ROOT, 'commands');
const CHECK = process.argv.includes('--check');

const c = { ok: (s) => `\x1b[32m${s}\x1b[0m`, bad: (s) => `\x1b[31m${s}\x1b[0m`, dim: (s) => `\x1b[2m${s}\x1b[0m` };

/** Frontmatter here is deliberately flat: name/description/whenToUse are standard,
 *  the rest are adapter hints copied into the dialects that understand them. */
function parse(file) {
  const text = readFileSync(file, 'utf8');
  const m = /^---\r?\n([\s\S]*?)\r?\n---\r?\n?/.exec(text);
  if (!m) throw new Error(`${file}: missing frontmatter`);
  const meta = {};
  for (const line of m[1].split(/\r?\n/)) {
    if (!line.trim() || line.trim().startsWith('#')) continue;
    const i = line.indexOf(':');
    if (i === -1) continue;
    let v = line.slice(i + 1).trim();
    if ((v.startsWith('"') && v.endsWith('"')) || (v.startsWith("'") && v.endsWith("'"))) v = v.slice(1, -1);
    meta[line.slice(0, i).trim()] = v;
  }
  return { meta, body: text.slice(m[0].length).trim() + '\n', file };
}

/**
 * Emit a double-quoted YAML scalar.
 *
 * This is not cosmetic: an unquoted value containing ": " (e.g. "Phase 1 — … spec: clarifying
 * questions") is invalid YAML, and a skill file with invalid frontmatter is *silently dropped* by
 * the provider — the command vanishes from the `/` menu with no diagnostic. Quoting every free-text
 * value is the only safe default.
 */
const q = (v) => `"${String(v).replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"`;

const yaml = (pairs) =>
  [
    '---',
    ...Object.entries(pairs)
      .filter(([, v]) => v !== undefined && v !== '')
      .map(([k, v]) => `${k}: ${v}`),
    '---',
  ].join('\n');

const note = (cmd) =>
  `\n<!-- GENERATED by .agent-sdlc/bin/sdlc-sync from .agent-sdlc/commands/${cmd}.md — do not edit this file. -->\n`;

function emit(cmd) {
  const { meta, body } = parse(join(CMD_DIR, `${cmd}.md`));
  const name = meta.name || cmd;
  const description = meta.description || `Run the ${name} phase`;
  const dshPreamble = `> Invoked as \`/${name}\`. Everything after the command name on the user's line is the phase input — read it before doing anything else.\n\n`;
  const out = {};

  // DSH: native skill. By default these are human `/` commands: `disable-model-invocation` keeps
  // them out of the model's catalog (saving catalog tokens on every request) while
  // `user-invocable` keeps the `/` entry visible. Add `model-invocable: true` to a command's
  // frontmatter if you also want the agent to be able to load it through the skill tool.
  const modelInvocable = meta['model-invocable'] === 'true';
  out[`.dsh/skills/${name}.md`] =
    yaml({
      name,
      description: q(description),
      whenToUse: meta.whenToUse ? q(meta.whenToUse) : undefined,
      'disable-model-invocation': modelInvocable ? 'false' : 'true',
      'user-invocable': 'true',
    }) +
    '\n\n' +
    dshPreamble +
    body +
    note(cmd);

  // Claude Code
  out[`.claude/commands/${name}.md`] =
    yaml({
      description: q(description),
      'argument-hint': meta['argument-hint'] ? q(meta['argument-hint']) : undefined,
      'allowed-tools': meta['allowed-tools'] ? q(meta['allowed-tools']) : undefined,
    }) +
    '\n\n' +
    body.replaceAll('$ARGUMENTS', '$ARGUMENTS') +
    note(cmd);

  // Cursor
  out[`.cursor/commands/${name}.md`] = yaml({ description: q(description) }) + '\n\n' + body + note(cmd);

  // opencode
  out[`.opencode/command/${name}.md`] =
    yaml({ description: q(description), agent: meta.agent, subtask: meta.subtask }) + '\n\n' + body + note(cmd);

  return out;
}

/**
 * Reject frontmatter that a YAML parser would choke on. Silent drops are the failure mode that
 * hurts most here: an unparseable skill simply never appears, and nothing tells you why.
 *
 * Uses the real `yaml` package when it is resolvable (it ships with dsh), and always applies the
 * dependency-free structural checks so this works in a bare checkout too.
 */
let yamlParse;
async function loadYamlParser() {
  if (yamlParse !== undefined) return yamlParse;
  for (const candidate of ['yaml', '@deepseek-ai/dsh/node_modules/yaml']) {
    try {
      const mod = await import(candidate);
      yamlParse = (mod.parse ?? mod.default?.parse);
      if (yamlParse) return yamlParse;
    } catch {
      /* try the next candidate */
    }
  }
  yamlParse = null;
  return yamlParse;
}

function validateFrontmatter(text, label, parse) {
  const problems = [];
  const m = /^---\r?\n([\s\S]*?)\r?\n---/.exec(text);
  if (!m) return [`${label}: no frontmatter block`];
  const block = m[1];

  for (const line of block.split(/\r?\n/)) {
    if (!line.trim()) continue;
    const colon = line.indexOf(':');
    if (colon === -1) {
      problems.push(`${label}: not a "key: value" line → ${line}`);
      continue;
    }
    const key = line.slice(0, colon).trim();
    const raw = line.slice(colon + 1).trim();
    if (raw === '') continue;
    const quoted = (raw.startsWith('"') && raw.endsWith('"')) || (raw.startsWith("'") && raw.endsWith("'"));
    if (quoted) {
      if (raw.startsWith('"') && raw.endsWith('"') && /(^|[^\\])"/.test(raw.slice(1, -1))) {
        problems.push(`${label}: "${key}" has an unescaped double quote`);
      }
      continue;
    }
    if (/: /.test(raw)) problems.push(`${label}: "${key}" contains ": " and must be quoted`);
    if (/^[[{*&!|>%@`]/.test(raw)) problems.push(`${label}: "${key}" starts with a YAML indicator`);
    if (raw.endsWith(':')) problems.push(`${label}: "${key}" ends with a colon`);
  }

  if (parse) {
    try {
      const parsed = parse(block);
      if (parsed === null || typeof parsed !== 'object') problems.push(`${label}: frontmatter did not parse to a mapping`);
    } catch (err) {
      problems.push(`${label}: YAML parse error → ${String(err.message).split('\n')[0]}`);
    }
  }
  return problems;
}

function main() {
  const yamlLoadPromise = loadYamlParser();
  return yamlLoadPromise.then((parse) => {
    if (!existsSync(CMD_DIR)) {
      console.error(`${c.bad('[FAIL]')} missing ${CMD_DIR}`);
      process.exit(1);
    }
    const cmds = readdirSync(CMD_DIR)
      .filter((f) => f.endsWith('.md'))
      .map((f) => f.replace(/\.md$/, ''))
      .sort();

    let changed = 0;
    const stale = [];
    const invalid = [];
    for (const cmd of cmds) {
      for (const [rel, content] of Object.entries(emit(cmd))) {
        invalid.push(...validateFrontmatter(content, rel, parse));
        const dest = join(ROOT, rel);
        const current = existsSync(dest) ? readFileSync(dest, 'utf8') : null;
        if (current === content) continue;
        changed++;
        if (CHECK) {
          stale.push(rel);
          continue;
        }
        mkdirSync(dirname(dest), { recursive: true });
        writeFileSync(dest, content);
      }
    }

    if (invalid.length) {
      console.error(`${c.bad('[FAIL]')} generated frontmatter would not parse — these commands would vanish:`);
      for (const p of invalid) console.error(`        · ${p}`);
      process.exit(1);
    }

    if (CHECK) {
      if (stale.length) {
        console.error(`${c.bad('[STALE]')} generated command files out of sync:`);
        for (const s of stale) console.error(`        · ${s}`);
        console.error(c.dim('        fix: bin/sdlc-sync'));
        process.exit(1);
      }
      console.log(`${c.ok('[OK]')} ${cmds.length} commands × 4 dialects in sync${parse ? ' (frontmatter parse-checked)' : ''}`);
      return;
    }
    console.log(`${c.ok('[OK]')} wrote ${changed} file(s) for ${cmds.length} command(s) ${c.dim(`(${cmds.join(', ')})`)}`);
  });
}

main();
