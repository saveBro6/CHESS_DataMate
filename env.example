# Environment contract for the DataMate runner. Copy to `.env` and replace every
# placeholder with a real value. The defaults shown are the runtime fallbacks.

# OpenAI-compatible LLM endpoint
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_BASE_URL=https://your-llm-endpoint.example/v1
OPENAI_LLM=replace-with-model-name
LLM_MAX_TOKENS=4096

# CHESS database root: the parent of <db_mode>_databases
DB_ROOT_PATH=./data/dev
DB_MODE=dev

# Index server kept for CHESS compatibility (unused when LSH loads in-process)
INDEX_SERVER_HOST=localhost
INDEX_SERVER_PORT=8000

# Embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cuda:0
EMBEDDING_BATCH=16
ENTITY_SIM_THRESHOLD=0.45
TOP_SIM_RATIO=0.90

# SQL execution
SQL_TIMEOUT_S=20

# Runner I/O
WORK_ROOT=./tmp/datamate-work (user specified this)
RESULT_DIR=./result (user specified this)

# Optional offline vLLM mode (--vllm)
USE_VLLM=0
VLLM_MODEL=Qwen/Qwen3.5-9B
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_EMBEDDING_GPU_MEMORY_UTILIZATION=0.05
